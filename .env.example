APP_NAME=OpenGRC
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AUTO_START=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Encrypt session payloads. Keep this on; it protects against session tampering
# if the storage directory is exposed.
SESSION_ENCRYPT=true
# Platform IP/email-domain allow/deny rules. Set false only for lockout recovery.
ACCESS_RULES_ENABLED=true
# Days before a control test is due that its owner is reminded.
CONTROL_TEST_REMINDER_DAYS=7
# Escalate a control test to administrators once it is this many days overdue.
# 0 keeps escalation off; owners are still reminded.
CONTROL_TEST_ESCALATION_AFTER_DAYS=0
# Set to true when serving over HTTPS. Production deployments with an https
# APP_URL force this on automatically.
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Configuration
# Provider: openai or digitalocean
AI_PROVIDER=openai
# Model: depends on provider (e.g., gpt-4.1-mini for OpenAI, alibaba-qwen3-32b for DigitalOcean)
AI_MODEL=

# AI API Keys (used as fallback when UI key is blank)
OPENAI_API_KEY=
DIGITALOCEAN_AI_KEY=

# AI Quota Settings (daily token limits, set to 0 to disable)
AI_PROMPT_QUOTA=1000000
AI_RESPONSE_QUOTA=1000000


# MCP / OAuth
# Dynamic client registration is disabled by default. Enable it deliberately and
# restrict the redirect domains.
# MCP_DYNAMIC_CLIENT_REGISTRATION=false
# MCP_REGISTRATION_REQUIRES_AUTH=true
# MCP_REDIRECT_DOMAINS=https://your-client.example.com/

# OpenDiscoveryEngine console mirror (read-only)
# The token is a tenant-scoped reader credential; see docs/integrations/open-discovery-console.md.
DISCOVERY_CONSOLE_URL=
DISCOVERY_CONSOLE_TOKEN=
DISCOVERY_CONSOLE_TENANT=
DISCOVERY_CONSOLE_TIMEOUT=15
DISCOVERY_CONSOLE_STALE_AFTER_DAYS=2

# Agent deployment guidance (no secrets; registration passwords come from your secret store)
WAZUH_MANAGER=
WAZUH_REGISTRATION_SERVER=
WAZUH_AGENT_GROUP=default
WAZUH_APT_REPOSITORY=https://packages.wazuh.com/4.x/apt/
WAZUH_YUM_REPOSITORY=https://packages.wazuh.com/4.x/yum/
WAZUH_WINDOWS_MSI_URL=
PATCHMON_SERVER_URL=
PATCHMON_INSTALL_COMMAND=
FLEET_URL=

# OpenMetadata catalog evidence (optional; URL and bot token are configured per source)
OPENMETADATA_CLASSIFICATIONS=PII
OPENMETADATA_PAGE_SIZE=100
OPENMETADATA_MAX_PAGES=50
OPENMETADATA_STALE_AFTER_DAYS=7

# OSV.dev vulnerability queries (optional; no token required)
OSV_API_URL=https://api.osv.dev
OSV_TIMEOUT=20
OSV_BATCH_SIZE=500

# DLP answer-key detector prefixes (comma-separated; empty disables the detector)
DLP_ANSWER_KEY_PREFIXES=OCR,TRAILLINE

# OpenBao secret metadata (optional; use a read-only metadata token)
OPENBAO_URL=
OPENBAO_TOKEN=
OPENBAO_KV_MOUNT=secret
OPENBAO_TIMEOUT=15

# deps.dev enrichment (optional; no token required)
DEPS_DEV_URL=https://api.deps.dev
DEPS_DEV_TIMEOUT=20

# Authentik OIDC (optional). Leave the client id blank to hide the SSO button.
# The redirect URI must match the Authentik application exactly:
#   <APP_URL>/app/oauth/callback/authentik
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=
